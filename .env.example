# Copiar a .env.local para desarrollo, y cargar los mismos valores reales
# en las variables de entorno de Netlify del sitio del cliente (nunca
# committear el .env real).

# Dominio real del cliente (sin / al final). Lo usan sitemap.ts, robots.ts
# y los datos estructurados.
NEXT_PUBLIC_SITE_URL=https://ejemplo-reemplazar-en-produccion.com

# Solo si plan.chatbotTier = "inteligente" (clientes con mensualidad).
# Una sola cuenta de API (platform.claude.com) para todos los clientes con
# mensualidad — no se relaciona con ninguna suscripción personal de chat.
# Sin esta variable, /api/chat responde 503 de forma controlada (no rompe
# el sitio: el resto del sitio funciona igual, el chatbot queda
# deshabilitado).
ANTHROPIC_API_KEY=
